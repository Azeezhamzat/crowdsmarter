# Django
DJANGO_SETTINGS_MODULE=crowdsmarter.settings.local
DJANGO_SECRET_KEY=replace-me-for-non-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_DEBUG=true

# PostgreSQL
POSTGRES_DB=crowdsmarter
POSTGRES_USER=crowdsmarter
POSTGRES_PASSWORD=crowdsmarter
DATABASE_URL=postgresql://crowdsmarter:crowdsmarter@db:5432/crowdsmarter

# Redis / Celery (optional for synchronous requests)
# Leave CACHE_URL empty for a zero-dependency single web process. Set it when using shared throttling/cache.
CACHE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Official contact and email delivery. All role addresses may initially route to hello@crowdsmarter.com.
PUBLIC_CONTACT_EMAIL=hello@crowdsmarter.com
SUPPORT_EMAIL=hello@crowdsmarter.com
PRIVACY_EMAIL=hello@crowdsmarter.com
SECURITY_EMAIL=hello@crowdsmarter.com
PLATFORM_ADMIN_EMAIL=hello@crowdsmarter.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="CrowdSmarter <hello@crowdsmarter.com>"
EMAIL_REPLY_TO=hello@crowdsmarter.com
DEMO_REQUEST_RECIPIENT=hello@crowdsmarter.com
DEMO_REQUEST_SEND_ACKNOWLEDGEMENT=false
API_DEMO_REQUEST_THROTTLE_RATE=5/hour
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=168

# Storage: local by default. Set STORAGE_BACKEND=s3 after installing the s3 extra.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_CONTACT_EMAIL=hello@crowdsmarter.com
VITE_DEMO_EMAIL=hello@crowdsmarter.com
VITE_SUPPORT_EMAIL=hello@crowdsmarter.com
VITE_PRIVACY_EMAIL=hello@crowdsmarter.com
VITE_SECURITY_EMAIL=hello@crowdsmarter.com
VITE_ADMIN_BASE_URL=http://localhost:8000/admin/
# Production frontend reverse proxy (not used by the Vite development server)
BACKEND_UPSTREAM=backend:8000

# Provider-neutral AI assistance. The default uses transparent local rules and no paid service.
AI_PROVIDER_BACKEND=apps.ai_assistance.providers.rules.RuleBasedAIProvider
API_AI_REVIEW_THROTTLE_RATE=20/hour

# Account security and customer data portability
PASSWORD_RESET_TIMEOUT=3600
API_PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour
API_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=20/hour
API_ACCOUNT_SECURITY_THROTTLE_RATE=20/hour
API_DATA_EXPORT_THROTTLE_RATE=20/hour

# Foresight source files and RSS/Atom feeds
SOURCE_ATTACHMENT_MAX_BYTES=15728640
SOURCE_ATTACHMENT_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/csv,application/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,image/webp
SOURCE_ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.txt,.csv,.docx,.xlsx,.png,.jpg,.jpeg,.webp
# Required in production before the server may retrieve feeds. Comma-separated domains only.
FORESIGHT_FEED_ALLOWED_DOMAINS=
API_FORESIGHT_FEED_SYNC_THROTTLE_RATE=20/hour

# Optional local first-run access. Used only when DJANGO_DEBUG=true and no active account exists.
LOCAL_BOOTSTRAP_EMAIL=owner@crowdsmarter.local
LOCAL_BOOTSTRAP_PASSWORD=
