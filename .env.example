# Django
DJANGO_SETTINGS_MODULE=crowdsmarter.settings.local
DJANGO_SECRET_KEY=replace-me-for-non-local-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_DEBUG=true

# PostgreSQL
POSTGRES_DB=crowdsmarter
POSTGRES_USER=crowdsmarter
POSTGRES_PASSWORD=crowdsmarter
DATABASE_URL=postgresql://crowdsmarter:crowdsmarter@db:5432/crowdsmarter

# Redis / Celery (optional for synchronous requests)
# Leave CACHE_URL empty for a zero-dependency single web process. Set it when using shared throttling/cache.
CACHE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email: console by default. Configure SMTP later without code changes.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@localhost
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=168

# Storage: local by default. Set STORAGE_BACKEND=s3 after installing the s3 extra.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Frontend
VITE_API_BASE_URL=/api/v1
# Production frontend reverse proxy (not used by the Vite development server)
BACKEND_UPSTREAM=backend:8000
