# Production environment for the DigitalOcean droplet deployment.
# Copy to .env.production on the droplet (never commit the real file — it's
# already covered by .gitignore's .env.* pattern), fill in every blank value,
# then always invoke compose with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production ...
# (add -f docker-compose.tls.yml once a certificate exists — see docs/deployment.md)

# Django
DJANGO_SETTINGS_MODULE=crowdsmarter.settings.production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=crowdsmarter.com,www.crowdsmarter.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crowdsmarter.com,https://www.crowdsmarter.com
DJANGO_DEBUG=false

# PostgreSQL. Pick a strong password and use the SAME value in both lines below.
POSTGRES_DB=crowdsmarter
POSTGRES_USER=crowdsmarter
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://crowdsmarter:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/crowdsmarter

# Redis / Celery. Shared cache and throttle state across gunicorn workers —
# unlike local dev, leave this set in production.
CACHE_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Official contact and email delivery — the hebeJahiz cPanel mailbox.
PUBLIC_CONTACT_EMAIL=hello@crowdsmarter.com
SUPPORT_EMAIL=hello@crowdsmarter.com
PRIVACY_EMAIL=hello@crowdsmarter.com
SECURITY_EMAIL=hello@crowdsmarter.com
PLATFORM_ADMIN_EMAIL=hello@crowdsmarter.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.crowdsmarter.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@crowdsmarter.com
# The hello@crowdsmarter.com mailbox password from cPanel. Set this directly
# on the droplet — don't paste it anywhere else.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="CrowdSmarter <hello@crowdsmarter.com>"
EMAIL_REPLY_TO=hello@crowdsmarter.com
DEMO_REQUEST_RECIPIENT=hello@crowdsmarter.com
DEMO_REQUEST_SEND_ACKNOWLEDGEMENT=false
API_DEMO_REQUEST_THROTTLE_RATE=5/hour
FRONTEND_BASE_URL=https://crowdsmarter.com
INVITATION_EXPIRY_HOURS=168

# Storage: local disk on the droplet to start. Move to S3-compatible
# (e.g. DigitalOcean Spaces) once you need multiple backend replicas.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Frontend (baked into the static build at image build time)
VITE_API_BASE_URL=/api/v1
VITE_PUBLIC_CONTACT_EMAIL=hello@crowdsmarter.com
VITE_DEMO_EMAIL=hello@crowdsmarter.com
VITE_SUPPORT_EMAIL=hello@crowdsmarter.com
VITE_PRIVACY_EMAIL=hello@crowdsmarter.com
VITE_SECURITY_EMAIL=hello@crowdsmarter.com
VITE_ADMIN_BASE_URL=https://crowdsmarter.com/admin/
BACKEND_UPSTREAM=backend:8000

# Provider-neutral AI assistance by default. Switch providers and add API
# keys from Platform Administration in the running app, not here.
AI_PROVIDER_BACKEND=apps.ai_assistance.providers.rules.RuleBasedAIProvider
API_AI_REVIEW_THROTTLE_RATE=20/hour

# Account security and customer data portability
PASSWORD_RESET_TIMEOUT=3600
API_PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour
API_PASSWORD_RESET_CONFIRM_THROTTLE_RATE=20/hour
API_ACCOUNT_SECURITY_THROTTLE_RATE=20/hour
API_DATA_EXPORT_THROTTLE_RATE=20/hour

# Foresight source files and RSS/Atom feeds
SOURCE_ATTACHMENT_MAX_BYTES=15728640
SOURCE_ATTACHMENT_ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/csv,application/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,image/webp
SOURCE_ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.txt,.csv,.docx,.xlsx,.png,.jpg,.jpeg,.webp
# Left empty: safely disables feed sync until you decide which domains to trust.
FORESIGHT_FEED_ALLOWED_DOMAINS=
API_FORESIGHT_FEED_SYNC_THROTTLE_RATE=20/hour
