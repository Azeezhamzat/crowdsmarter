#: apps/invitations/services.py:253
#, python-format
msgid "Invitation to join %(organisation)s on CrowdSmarter"
msgstr "Invitation à rejoindre %(organisation)s sur CrowdSmarter"

#: apps/invitations/services.py:257
#, python-format
msgid ""
"You have been invited to join %(organisation)s as %(role)s.\n"
"\n"
"Accept the invitation and create or connect your account here:\n"
"%(url)s\n"
"\n"
"This link expires at %(expires)s.\n"
"If you were not expecting this invitation, you can ignore this email."
msgstr ""
"Vous avez été invité(e) à rejoindre %(organisation)s en tant que "
"%(role)s.\n"
"\n"
"Acceptez l'invitation et créez ou connectez votre compte ici :\n"
"%(url)s\n"
"\n"
"Ce lien expire le %(expires)s.\n"
"Si vous n'attendiez pas cette invitation, vous pouvez ignorer cet e-mail."
