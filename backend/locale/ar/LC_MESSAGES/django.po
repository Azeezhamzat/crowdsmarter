#: apps/invitations/services.py:263
#, python-format
msgid ""
"You have been invited to join %(organisation)s as %(role)s.\n"
"\n"
"Accept the invitation and create or connect your account here:\n"
"%(url)s\n"
"\n"
"This link expires at %(expires)s.\n"
"If you were not expecting this invitation, you can ignore this email."
msgstr ""
"تمت دعوتك للانضمام إلى %(organisation)s بصفتك %(role)s.\n"
"\n"
"اقبل الدعوة وأنشئ حسابك أو اربطه من هنا:\n"
"%(url)s\n"
"\n"
"تنتهي صلاحية هذا الرابط في %(expires)s.\n"
"إذا لم تكن تتوقع هذه الدعوة، فيمكنك تجاهل هذه الرسالة."
